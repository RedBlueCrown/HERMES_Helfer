 "cards": [
  {
   "dot": "cyan",
   "title": "How the assistant works",
   "items": [
    "The engine orchestrates: next step, tasks, permissions; A1 reads it, it does not steer the agents",
    "Ten read-only tools return the engine's facts: next step, tasks, gate, results, risks, status, minutes",
    "The eleventh tool starts a draft, only when the person asks; no tool can decide or release"
   ]
  },
  {
   "dot": "violet",
   "title": "Drafting pipeline",
   "items": [
    "The runner hands a drafting agent the skill, the project's facts and the template's fields",
    "The Kritiker checks every draft: checklist first, then the model",
    "Draft and findings are recorded; a person releases or decides. «Entwurf erstellen» starts the same runner"
   ]
  },
  {
   "dot": "amber",
   "title": "Proposals, knowledge and limits",
   "items": [
    "A9 minutes, A10 change requests, A12 risks and A2 status texts are proposals a person accepts",
    "A13 searches only what the person may read and names its sources",
    "Every model call passes the quota gate"
   ]
  }
 ]

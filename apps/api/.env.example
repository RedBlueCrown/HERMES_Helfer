# Copy to .env for local overrides. Never commit real values.
NODE_ENV=development
PORT=3001

# dev: sign in with a dev user (x-dev-user header). entra (default): validate Entra ID tokens.
# Dev sign-in is refused in production and whenever the API runs in Azure.
AUTH_MODE=dev
# ENTRA_TENANT_ID=
# ENTRA_API_CLIENT_ID=
# Client ID of the web app registration; the browser reads it from /api/config.
# ENTRA_WEB_CLIENT_ID=
# Scope the web app requests, if the API's identifier URI is not api://<ENTRA_API_CLIENT_ID>.
# ENTRA_API_SCOPE=api://hermes-helfer-pilot/access_as_user

# memory: in memory, optionally kept as JSON lines in DATA_DIR. sql: Azure SQL or SQL Server 2022+.
STORE=memory
DATA_DIR=.data
# SQL_SERVER=<server>.database.windows.net
# SQL_DATABASE=hermes-helfer
# entra: managed identity in Azure, your Azure CLI login locally. password: local containers only.
# SQL_AUTH=entra
# SQL_USER=
# SQL_PASSWORD=
# SQL_TRUST_SERVER_CERTIFICATE=false
# Apply database migrations at startup (local only; Azure runs the migration job).
# SQL_MIGRATE_ON_START=false
# Client ID of the user-assigned managed identity (Azure only).
# AZURE_CLIENT_ID=

SEED_DEMO=true
SEED_SYNTHETIC_PROJECTS=300

# mock: no model, placeholder drafts. azure-openai: Azure OpenAI deployment in the EU.
AI_PROVIDER=mock
MOCK_AI_LATENCY_MS=1200
# AZURE_OPENAI_ENDPOINT=https://<resource>.openai.azure.com
# AZURE_OPENAI_DEPLOYMENT_DRAFT=
# AZURE_OPENAI_DEPLOYMENT_CHAT=
# AZURE_OPENAI_REGION_LABEL=Sweden Central (regional)
# v1 (default): the versionless v1 API. Or a dated api-version for the older deployments path.
# AZURE_OPENAI_API_VERSION=v1
# Upper bound per model call, reasoning included (default 16000).
# AZURE_OPENAI_MAX_COMPLETION_TOKENS=16000
# Reasoning models only (GPT-5 series): none (GPT-5.1), minimal (GPT-5), low, medium or high. Unset sends nothing.
# AZURE_OPENAI_REASONING_EFFORT=low
# AZURE_OPENAI_TIMEOUT_MS=180000

# Telemetry to Application Insights (Azure only).
# APPLICATIONINSIGHTS_CONNECTION_STRING=

# Behind a reverse proxy: its addresses or CIDR ranges, so the client address is taken from
# X-Forwarded-For (in Azure the Container Apps subnet). Unset: no proxy is trusted.
# TRUSTED_PROXIES=10.40.0.0/23
# Requests per minute per signed-in person (per client address before sign-in).
# RATE_LIMIT_PER_MINUTE=600

# Copy to .env for local overrides. Never commit real values.
NODE_ENV=development
PORT=3001
# dev: sign in with a dev user (x-dev-user header). entra: validate Entra ID tokens.
AUTH_MODE=dev
# ENTRA_TENANT_ID=
# ENTRA_API_CLIENT_ID=
# Keep events across restarts (JSON lines per project). Empty: in memory only.
DATA_DIR=.data
SEED_DEMO=true
SEED_SYNTHETIC_PROJECTS=300
# mock: no model, placeholder drafts. azure-openai: Azure OpenAI deployment in the EU.
AI_PROVIDER=mock
MOCK_AI_LATENCY_MS=1200
# AZURE_OPENAI_ENDPOINT=https://<resource>.openai.azure.com
# AZURE_OPENAI_DEPLOYMENT_DRAFT=
# AZURE_OPENAI_DEPLOYMENT_CHAT=
# AZURE_OPENAI_REGION_LABEL=Sweden Central (regional)

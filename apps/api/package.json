{
  "name": "@hermes-helfer/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "HERMES Helfer API: auth, commands, event store, agent runtime.",
  "scripts": {
    "dev": "tsx watch --clear-screen=false --env-file=dev.env src/main.ts",
    "start": "node --enable-source-maps --import ./dist/telemetry.js dist/main.js",
    "migrate": "node --enable-source-maps --import ./dist/telemetry.js dist/migrate.js",
    "build": "node build.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "eval": "tsx src/eval/main.ts"
  },
  "dependencies": {
    "@azure/identity": "^4.14.0",
    "@azure/monitor-opentelemetry": "^1.20.1",
    "@fastify/helmet": "^13.2.0",
    "@fastify/rate-limit": "^11.2.1",
    "@fastify/static": "^10.1.7",
    "@hermes-helfer/core": "*",
    "@opentelemetry/api": "^1.10.0",
    "@opentelemetry/instrumentation": "^0.300.0",
    "@opentelemetry/instrumentation-pino": "^0.70.0",
    "@opentelemetry/instrumentation-tedious": "^0.43.0",
    "@opentelemetry/instrumentation-undici": "^0.34.0",
    "@xmldom/xmldom": "^0.9.12",
    "fastify": "^5.12.7",
    "fflate": "^0.8.3",
    "jose": "^6.2.13",
    "mssql": "^12.7.11",
    "pino": "^10.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "@types/mssql": "^12.3.0",
    "@types/node": "^22.19.0",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "vitest": "^5.0.5"
  }
}

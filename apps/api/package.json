{
  "name": "@hermes-helfer/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "HERMES Helfer API: auth, commands, event store, agent runtime.",
  "scripts": {
    "dev": "tsx watch --clear-screen=false --env-file=dev.env src/main.ts",
    "start": "node --enable-source-maps --import ./dist/telemetry.js dist/main.js",
    "migrate": "node --enable-source-maps --import ./dist/telemetry.js dist/migrate.js",
    "build": "node build.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@azure/identity": "^4.13.3",
    "@azure/monitor-opentelemetry": "^1.20.1",
    "@fastify/helmet": "^13.1.2",
    "@fastify/rate-limit": "^11.2.1",
    "@fastify/static": "^10.1.5",
    "@hermes-helfer/core": "*",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/instrumentation": "^0.221.0",
    "@opentelemetry/instrumentation-pino": "^0.67.0",
    "@opentelemetry/instrumentation-tedious": "^0.40.0",
    "@opentelemetry/instrumentation-undici": "^0.31.0",
    "fastify": "^5.12.5",
    "jose": "^6.2.12",
    "mssql": "^12.7.4",
    "pino": "^10.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/mssql": "^12.3.0",
    "@types/node": "^26.6.4",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "vitest": "^5.0.3"
  }
}

{
  "name": "hermes-helfer",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,magenta \"npm run dev -w @hermes-helfer/api\" \"npm run dev -w @hermes-helfer/web\"",
    "dev:reset": "node -e \"require('node:fs').rmSync('apps/api/.data',{recursive:true,force:true})\"",
    "lint": "oxlint --type-aware --tsconfig tsconfig.base.json --deny-warnings",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "e2e": "npm run e2e -w @hermes-helfer/web",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "concurrently": "^10.0.6",
    "oxlint": "^1.87.0",
    "oxlint-tsgolint": "^7.0.2003",
    "prettier": "^3.9.9",
    "typescript": "^7.0.2"
  }
}
